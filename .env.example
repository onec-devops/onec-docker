# Copy to .env and adjust. Only ONEC_VERSION is required; the commented lines show
# the defaults from compose.yaml, uncomment one to change it.

# Platform version; the build takes its archive from distr/
ONEC_VERSION=8.3.25.1633

# Platform archive in distr/ as downloaded from releases.1c.ru
# ONEC_ARCHIVE=server64_8_3_25_1633.zip

# Service used by commands without a service name, such as 'docker compose up -d':
# server or full
COMPOSE_PROFILES=server

# Installer components, comma-separated
# ONEC_COMPONENTS=server,ws

# Client components added in the full image; client_full adds the thick client and Designer
# ONEC_CLIENT_COMPONENTS=client_thin

# Image namespace: images <namespace>/1cv8-server and <namespace>/1cv8-full, tagged with ONEC_VERSION
# IMAGE_NAMESPACE=onec-devops

# Hostname the cluster registers under; clients must resolve it to the Docker host
# ONEC_HOSTNAME=onec-server

# MAC address of the server container; software licenses are bound to it
# ONEC_MAC_ADDRESS=02:1c:08:03:00:01

# Time zone of the containers: the server returns its local time from ТекущаяДата()
# TZ=Europe/Moscow

# Start ragent with -debug -http and the debug server
# ONEC_DEBUG=false

# Ports, change them all together if the defaults are taken on the host
# ONEC_PORT=1540
# ONEC_REGPORT=1541
# ONEC_RANGE_START=1560
# ONEC_RANGE_END=1591
# ONEC_RAS_PORT=1545
# ONEC_DEBUG_PORT=1550

# Start the virtual display with the VNC server and noVNC in the full image
# START_DISPLAY=true

# Host port of the VNC server in the full image
# VNC_PORT=5900

# Password of the VNC server in the full image, also asked by noVNC; at most 8 characters.
# No password by default.
# VNC_PASSWORD=vnc_password

# Host port of the noVNC web client in the full image
# NOVNC_PORT=6080

# Size in pixels, color depth in bits and DPI of the virtual display in the full image
# SCREEN_WIDTH=1920
# SCREEN_HEIGHT=1080
# SCREEN_DEPTH=24
# SCREEN_DPI=96
